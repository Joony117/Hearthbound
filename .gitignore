# Godot 4
.godot/
/android/

# Engine binary + installer, kept on disk but out of history (170 MB + 80 MB)
tools/

# Build output
export/
*.exe
*.pck
*.zip

# Stage playtests (ig-eek): each launcher's own APPDATA, made on first run
playtest/*/appdata/

# Agent working files (logs + artifacts, per WORKER-CONTRACT.md)
.agent-results/

# Panther relay scratch — the agent prompts in panther/ are committed, the churn is not
panther/in.md
panther/out.md
panther/review.md

# Editor / OS noise
*.tmp
.DS_Store
Thumbs.db
.serena/
.gitnexus/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
